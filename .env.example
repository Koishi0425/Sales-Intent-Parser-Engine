# Optional. When absent, the project uses a local heuristic parser for demos/tests.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_ENABLE_THINKING=false
LLM_ENABLE_SEARCH=false
LLM_CACHE_CONTROL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=60

# Domain defaults.
PER_USER_BANDWIDTH_MBPS=1
HIGH_BANDWIDTH_THRESHOLD_MBPS=100
